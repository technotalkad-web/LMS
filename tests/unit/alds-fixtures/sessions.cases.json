{
  "$comment": "checkSession golden cases (ADR 0005 step 9): ordering within a session (G3) and once per registration (R5). Steps name base.json statements in stored order; 'name#n' gives the copy a fresh id; {base, patch} patches it. Context: the base LaunchData unless 'bare'.",
  "cases": [
    { "name": "a full valid session", "steps": ["initialized", "answered-choice", "answered-true-false", "run-summary", "answered-fill-in", "progressed", "completed", "passed", "terminated"], "expect": [] },
    { "name": "a valid session without a template (AU id from the statements)", "context": "bare", "steps": ["initialized", "answered-choice", "completed", "terminated"], "expect": [] },
    { "name": "G3 a statement before initialized", "steps": ["answered-choice", "initialized", "terminated"], "expect": [["G3", "statement_before_initialized", { "index": 0, "attribution": "package" }]] },
    { "name": "G3 terminated before initialized", "steps": ["terminated", "initialized", "terminated#2"], "expect": [["G3", "statement_before_initialized", { "index": 0 }]] },
    { "name": "G3 a second initialized in an open session", "steps": ["initialized", "initialized#2", "terminated"], "expect": [["G3", "initialized_twice", { "index": 1 }]] },
    { "name": "G3 a statement after terminated (KIVO review navigation after Results)", "steps": ["initialized", "terminated", "answered-choice", "progressed"], "expect": [["G3", "statement_after_terminated", { "index": 2 }], ["G3", "statement_after_terminated", { "index": 3 }]] },
    { "name": "G3 re-initialized under the same sessionid (engine reopen, ADR 0006 step 4): its own package-attributed warning (open decision), then checked as a new session", "steps": ["initialized", "terminated", "initialized#2", "answered-choice", "terminated#3"], "expect": [["G3", "session_reopened", { "index": 2, "severity": "warn", "attribution": "package" }]], "ok": true },
    { "name": "G3 a relaunch with a new sessionid is clean", "steps": ["initialized", "terminated", { "base": "initialized#2", "patch": [["set", ["context", "extensions", "SESSION"], "d3e4f5a6-b7c8-4d9e-8f01-2a3b4c5d6e7f"]] }, { "base": "answered-choice", "patch": [["set", ["context", "extensions", "SESSION"], "d3e4f5a6-b7c8-4d9e-8f01-2a3b4c5d6e7f"]] }, { "base": "terminated#3", "patch": [["set", ["context", "extensions", "SESSION"], "d3e4f5a6-b7c8-4d9e-8f01-2a3b4c5d6e7f"]] }], "expect": [] },
    { "name": "G3 an abandoned session (no terminated) followed by a new session is clean", "steps": ["initialized", "answered-choice", { "base": "initialized#2", "patch": [["set", ["context", "extensions", "SESSION"], "e4f5a6b7-c8d9-4e0f-9a12-3b4c5d6e7f80"]] }, { "base": "terminated", "patch": [["set", ["context", "extensions", "SESSION"], "e4f5a6b7-c8d9-4e0f-9a12-3b4c5d6e7f80"]] }], "expect": [] },
    { "name": "G3 a launched the LMS recorded is outside the AU's ordering", "steps": [{ "base": "progressed#9", "patch": [["set", ["verb", "id"], "http://adlnet.gov/expapi/verbs/launched"]], "origin": "lms" }, "initialized", "terminated"], "expect": [] },
    { "name": "G3 a launched sent by content is ordered like any content statement", "steps": [{ "base": "progressed#9", "patch": [["set", ["verb", "id"], "http://adlnet.gov/expapi/verbs/launched"]] }, "initialized", "terminated"], "expect": [["G3", "statement_before_initialized", { "index": 0 }]] },
    { "name": "G3 a satisfied the LMS recorded after terminated is outside the AU's ordering", "steps": ["initialized", "completed", "terminated", { "base": "progressed#9", "patch": [["set", ["verb", "id"], "https://w3id.org/xapi/adl/verbs/satisfied"]], "origin": "lms" }], "expect": [] },
    { "name": "G3 a satisfied sent by content after terminated", "steps": ["initialized", "completed", "terminated", { "base": "progressed#9", "patch": [["set", ["verb", "id"], "https://w3id.org/xapi/adl/verbs/satisfied"]] }], "expect": [["G3", "statement_after_terminated", { "index": 3 }]] },
    { "name": "a resent statement with the same id is one statement (write-once storage)", "steps": ["initialized", "completed", "completed", "terminated"], "expect": [] },
    { "name": "R5 a second completed in one registration", "steps": ["initialized", "completed", "completed#2", "terminated"], "expect": [["R5", "completed_twice", { "index": 2 }]] },
    { "name": "R5 a second passed across two sessions of one registration", "steps": ["initialized", "passed", "terminated", { "base": "initialized#2", "patch": [["set", ["context", "extensions", "SESSION"], "f5a6b7c8-d9e0-4f1a-8b23-4c5d6e7f8091"]] }, { "base": "passed#3", "patch": [["set", ["context", "extensions", "SESSION"], "f5a6b7c8-d9e0-4f1a-8b23-4c5d6e7f8091"]] }, { "base": "terminated#4", "patch": [["set", ["context", "extensions", "SESSION"], "f5a6b7c8-d9e0-4f1a-8b23-4c5d6e7f8091"]] }], "expect": [["R5", "passed_twice", { "index": 4 }]] },
    { "name": "G3 failed after passed in one registration", "steps": ["initialized", "passed", "failed", "terminated"], "expect": [["G3", "failed_after_passed", { "index": 2 }]] },
    { "name": "G3/R5 failed, then passed is allowed", "steps": ["initialized", "failed", "failed#2", "passed", "terminated"], "expect": [] },
    { "name": "R5 a new registration may complete again", "steps": ["initialized", "completed", "terminated", { "base": "initialized#2", "patch": [["set", ["context", "registration"], "6c9d4e3f-0a2b-4c7d-9e8f-2b3c4d5e6f70"], ["set", ["context", "extensions", "SESSION"], "a6b7c8d9-e0f1-4a2b-9c34-5d6e7f8091a2"]] }, { "base": "completed#3", "patch": [["set", ["context", "registration"], "6c9d4e3f-0a2b-4c7d-9e8f-2b3c4d5e6f70"], ["set", ["context", "extensions", "SESSION"], "a6b7c8d9-e0f1-4a2b-9c34-5d6e7f8091a2"]] }, { "base": "terminated#4", "patch": [["set", ["context", "registration"], "6c9d4e3f-0a2b-4c7d-9e8f-2b3c4d5e6f70"], ["set", ["context", "extensions", "SESSION"], "a6b7c8d9-e0f1-4a2b-9c34-5d6e7f8091a2"]] }], "expect": [] },
    { "name": "R5 quiz run summaries are not AU-level (a retake run passes again)", "steps": ["initialized", "run-summary", { "base": "run-summary#2", "patch": [["set", ["context", "extensions", "E:question/run"], 2]] }, "terminated"], "expect": [] },
    { "name": "R5 Results re-rendered: the outcome re-sent with new ids (KIVO defect)", "steps": ["initialized", "completed", "passed", "completed#2", "passed#3", "terminated"], "expect": [["R5", "completed_twice", { "index": 3 }], ["R5", "passed_twice", { "index": 4 }]] },
    { "name": "G1-broken entries are skipped (checkStatement reports them)", "steps": ["initialized", { "base": "progressed", "patch": [["del", ["verb"]]] }, "terminated"], "expect": [] },
    { "name": "G3 not an array", "input": { "statements": [] }, "expect": [["G3", "not_an_array"]] }
  ]
}
